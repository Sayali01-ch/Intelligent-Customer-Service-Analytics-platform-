# Environment Configuration

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/customer_analytics

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production

# Application Settings
DEBUG=False
LOG_LEVEL=INFO

# API Configuration
API_TIMEOUT=30
MAX_BATCH_SIZE=100

# File Upload Settings
MAX_FILE_SIZE=52428800

# Feature Flags
ENABLE_BATCH_PROCESSING=True
ENABLE_EXPORT=True
ENABLE_API=True